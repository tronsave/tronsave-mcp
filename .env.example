MCP_SERVER_NAME=TronSave MCP Server
MCP_SERVER_VERSION=1.4.1
MCP_PORT=3000
# `memory` runs without Redis (single instance, sessions lost on restart; trials only)
REDIS_URL=redis://localhost:6379
GRAPHQL_TIMEOUT_MS=10000
REST_TIMEOUT_MS=10000
REST_RETRIES=2
SIGN_MESSAGE_TTL_SECONDS=300
SESSION_TTL_SECONDS=86400
SIGNATURE_MAX_AGE_SECONDS=86400
LOG_LEVEL=info
NODE_ENV=development
AUTH_VERIFY_CACHE_TTL_SECONDS=60
READINESS_UPSTREAM_TIMEOUT_MS=2000
PUBLIC_BASE_URL=
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
TRUST_PROXY=1
# Bearer token required by GET /metrics; leave empty only when /metrics is not reachable from the internet
METRICS_TOKEN=

# stdio only (`npm run start:stdio`): network and optional API key for the local server
# TRONSAVE_NETWORK=mainnet
# TRONSAVE_API_KEY=

{
  "name": "tronsave-mcp",
  "version": "1.3.0",
  "description": "Agent-native MCP server for TronSave: rent TRON ENERGY/BANDWIDTH and manage TronSave accounts over Streamable HTTP, with API-key or wallet-signature auth.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "docs:tools": "tsx scripts/gen-tool-docs.ts",
    "smoke": "node scripts/smoke.mjs",
    "e2e:testnet": "node scripts/testnet-e2e.mjs",
    "publish:public": "scripts/publish-public.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tronsave/tronsave-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tron",
    "tronsave",
    "energy",
    "bandwidth",
    "ai-agent"
  ],
  "author": "TronSave",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tronsave/tronsave-mcp/issues"
  },
  "homepage": "https://github.com/tronsave/tronsave-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "ioredis": "^5.10.1",
    "opossum": "^9.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tronweb": "^6.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/opossum": "^8.1.9",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
